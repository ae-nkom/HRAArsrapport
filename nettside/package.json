{
  "name": "hr-arsrapport-evidence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3773 --strictPort",
    "build": "vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --port 3773 --strictPort",
    "test": "node --test test/*.test.js",
    "check": "svelte-check --threshold error",
    "test:browser": "playwright test",
    "verify": "npm run check && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "autoprefixer": "10.5.4",
    "docx": "^9.5.1",
    "postcss": "8.5.26",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "fflate": "^0.8.3"
  }
}
